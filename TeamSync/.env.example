# Copy this file and rename it to .env on your computer.
# Do not commit your real .env file.

EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace_with_your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_with_your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=replace_with_your_app_id
