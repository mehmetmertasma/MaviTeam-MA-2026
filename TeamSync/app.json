{
  "expo": {
    "name": "MaviTeam",
    "slug": "maviteam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maviteam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.maviteam.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.maviteam.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2B6BFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B6BFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2B6BFF"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "maviteam",
          "project": "maviteam-app",
          "url": "https://de.sentry.io/"
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a5a5c066-b548-498f-a8b8-4bb3844a156d"
      }
    },
    "owner": "mertasma"
  }
}
