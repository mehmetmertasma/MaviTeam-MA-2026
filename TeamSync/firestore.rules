rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function currentUserProfile() {
      return userDoc(request.auth.uid);
    }

    function currentUserHasProfile() {
      return verifiedEmail() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserClubId() {
      return currentUserProfile().data.clubId;
    }

    function currentUserRole() {
      return currentUserProfile().data.role;
    }

    function currentUserTeamIds() {
      return currentUserProfile().data.teamIds;
    }

    function currentUserIsActive() {
      return currentUserProfile().data.status == 'active';
    }

    function currentUserIsClubAdmin() {
      return currentUserHasProfile() && currentUserIsActive() && currentUserRole() == 'clubAdmin';
    }

    function currentUserIsCoach() {
      return currentUserHasProfile() && currentUserIsActive() && currentUserRole() == 'coach';
    }

    function currentUserIsClubStaff() {
      return currentUserIsClubAdmin() || currentUserIsCoach();
    }

    function clubDoc(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId));
    }

    // Missing 'status' (every club written before the platform admin panel
    // existed) is treated as active. A nonexistent clubId makes get() error,
    // which Firestore treats as a denied request -- exactly what we want.
    function clubIsActive(clubId) {
      return clubDoc(clubId).data.get('status', 'active') != 'suspended';
    }

    // The one place a platform-admin "suspend club" action actually takes
    // effect: nearly every collection's rules funnel through this function,
    // so gating it here cuts off a suspended club's data everywhere at
    // once, for every role, without touching each collection individually.
    function belongsToCurrentUsersClub(clubId) {
      return currentUserHasProfile() && currentUserIsActive() && currentUserClubId() == clubId && clubIsActive(clubId);
    }

    // Same membership check as belongsToCurrentUsersClub, minus the
    // suspension gate -- used only by clubs/{clubId}'s own read rule below,
    // so that every active member (not just the club's owner) can still see
    // their own club's name/status/subscription and land on a friendly
    // "please renew" screen instead of a permission-denied error when it's
    // suspended. Every other collection keeps funneling through
    // belongsToCurrentUsersClub above, so suspension still cuts off
    // everything else exactly as before.
    function currentUserClubMembershipRegardlessOfSuspension(clubId) {
      return currentUserHasProfile() && currentUserIsActive() && currentUserClubId() == clubId;
    }

    function isCurrentUsersTeam(teamId) {
      return currentUserHasProfile()
        && teamId is string
        && teamId in currentUserTeamIds();
    }

    function isClubWideData(data) {
      return !('teamId' in data) || data.teamId == null || data.teamId == '';
    }

    function isCurrentUsersTeamData(data) {
      return ('teamId' in data) && isCurrentUsersTeam(data.teamId);
    }

    function canReadClubWideOrOwnTeamData(data) {
      return belongsToCurrentUsersClub(data.clubId)
        && (
          currentUserIsClubAdmin()
          || isClubWideData(data)
          || isCurrentUsersTeamData(data)
        );
    }

    function canCoachManageOwnTeamData(data) {
      return currentUserIsCoach()
        && data.clubId == currentUserClubId()
        && ('teamId' in data)
        && isCurrentUsersTeam(data.teamId);
    }

    function canReadAnnouncement(data) {
      return belongsToCurrentUsersClub(data.clubId)
        && (
          currentUserIsClubAdmin()
          || data.targetType == 'allClub'
          || (data.targetType == 'team' && ('targetTeamId' in data) && isCurrentUsersTeam(data.targetTeamId))
        );
    }

    function canCreateOrUpdateAnnouncement(data) {
      return data.clubId == currentUserClubId()
        && (
          currentUserIsClubAdmin()
          || (currentUserIsCoach() && data.targetType == 'team' && ('targetTeamId' in data) && isCurrentUsersTeam(data.targetTeamId))
        );
    }

    function canReadAttendance(data) {
      return belongsToCurrentUsersClub(data.clubId)
        && (
          currentUserIsClubAdmin()
          || data.userId == request.auth.uid
          || isCurrentUsersTeamData(data)
        );
    }

    function canCreateOrUpdateAttendance(data) {
      return data.clubId == currentUserClubId()
        && data.recordedByUserId == request.auth.uid
        && (
          currentUserIsClubAdmin()
          || (currentUserIsCoach() && isCurrentUsersTeamData(data))
        );
    }

    function canReadPayment(data) {
      return belongsToCurrentUsersClub(data.clubId)
        && (
          currentUserIsClubAdmin()
          || data.userId == request.auth.uid
        );
    }

    function canReadChatGroupData(data) {
      return belongsToCurrentUsersClub(data.clubId)
        && (
          currentUserIsClubAdmin()
          || (('visibleUserIds' in data) && data.visibleUserIds is list && request.auth.uid in data.visibleUserIds)
          || isCurrentUsersTeamData(data)
        );
    }

    function canCreateOrUpdateChatGroupData(data) {
      return data.clubId == currentUserClubId()
        && (
          currentUserIsClubAdmin()
          || (currentUserIsCoach() && isCurrentUsersTeamData(data))
        );
    }

    function chatGroupExists(groupId) {
      return groupId is string
        && exists(/databases/$(database)/documents/chatGroups/$(groupId));
    }

    function chatGroupData(groupId) {
      return get(/databases/$(database)/documents/chatGroups/$(groupId)).data;
    }

    // Group-message visibility is read from data.visibleUserIds directly rather
    // than looking up the chatGroups doc (see canCreateChatMessage, which is the
    // only place that trusts that field) -- see the chatMessages match block
    // below for why read authorization is split into separate allow statements
    // instead of one function here.
    function canCreateChatMessage(data) {
      return currentUserHasProfile()
        && currentUserIsActive()
        && data.clubId == currentUserClubId()
        && data.senderUserId == request.auth.uid
        && (
          (('directUserIds' in data) && data.directUserIds is list && request.auth.uid in data.directUserIds)
          || (
            ('groupId' in data) && chatGroupExists(data.groupId) && canReadChatGroupData(chatGroupData(data.groupId))
            && data.visibleUserIds == chatGroupData(data.groupId).visibleUserIds
          )
        );
    }

    function canCreateOrUpdateReplay(data) {
      return data.clubId == currentUserClubId()
        && data.createdByUserId == request.auth.uid
        && (
          currentUserIsClubAdmin()
          || (currentUserIsCoach() && isCurrentUsersTeamData(data))
        );
    }

    // Records whether a not-yet-verified account meant to create a club or
    // join one, so /login can route them correctly if they come back after
    // closing the app instead of finishing verification in the same
    // session as register.tsx's own (correctly-parameterized) redirect.
    // Self-scoped only, written directly by the client (not a Cloud
    // Function), before email verification -- so this can't require
    // verifiedEmail() the way users/{userId} below does.
    match /registrationIntents/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId} {
      allow create: if verifiedEmail()
        && isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified is bool
        && request.resource.data.status == 'emailVerified'
        && request.resource.data.clubId == null
        && request.resource.data.teamIds is list
        && (request.resource.data.role == 'clubAdmin' || request.resource.data.role == 'coach' || request.resource.data.role == 'parent' || request.resource.data.role == 'athlete');

      allow read: if isSelf(userId)
        || (currentUserIsClubStaff() && resource.data.clubId == currentUserClubId());

      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.clubId == resource.data.clubId;

      allow update: if verifiedEmail()
        && isSelf(userId)
        && resource.data.uid == request.auth.uid
        && resource.data.email == request.auth.token.email
        && resource.data.emailVerified is bool
        && resource.data.status == 'emailVerified'
        && resource.data.clubId == null
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.emailVerified is bool
        && request.resource.data.role == 'clubAdmin'
        && request.resource.data.status == 'active'
        && request.resource.data.clubId is string
        && request.resource.data.teamIds is list;

      allow update: if verifiedEmail()
        && isSelf(userId)
        && resource.data.uid == request.auth.uid
        && resource.data.email == request.auth.token.email
        && resource.data.emailVerified is bool
        && (resource.data.status == 'emailVerified' || resource.data.status == 'pending')
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.emailVerified is bool
        && (request.resource.data.role == 'coach' || request.resource.data.role == 'parent' || request.resource.data.role == 'athlete')
        && request.resource.data.status == 'pending'
        && request.resource.data.clubId is string
        && request.resource.data.teamIds is list;

      allow update: if currentUserIsClubAdmin()
        && resource.data.clubId == currentUserClubId()
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    match /clubs/{clubId} {
      // A club now only ever comes into existence server-side, once payment
      // or a promo code is confirmed (startClubSignup, or the Stripe webhook
      // completing a checkout) -- see functions/index.js. Letting a client
      // create its own club doc directly would let it walk straight past
      // that entire billing gate, so this is Admin-SDK-only now.
      allow create: if false;

      allow read: if currentUserClubMembershipRegardlessOfSuspension(clubId)
        || (verifiedEmail() && resource.data.ownerId == request.auth.uid);

      // paymentAccount and subscription can only ever move via the Admin SDK
      // -- paymentAccount via connectPaymentAccount / the Stripe+iyzico
      // account webhooks, subscription via startClubSignup, the Stripe
      // subscription webhooks, cancelClubSubscription, and the grace-period
      // cron. A clubAdmin could otherwise just hand-write
      // subscription.status: "active" and skip paying entirely.
      allow update: if currentUserIsClubAdmin()
        && belongsToCurrentUsersClub(clubId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('paymentAccount', null) == resource.data.get('paymentAccount', null)
        && request.resource.data.get('subscription', null) == resource.data.get('subscription', null);

      allow delete: if false;
    }

    match /clubCodes/{clubCode} {
      allow read: if verifiedEmail();

      allow create: if verifiedEmail()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.clubId is string
        && request.resource.data.code == clubCode
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerId == request.auth.uid;

      allow update: if verifiedEmail()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.code == clubCode
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerId == request.auth.uid;

      allow delete: if verifiedEmail()
        && resource.data.ownerId == request.auth.uid
        && resource.data.clubId is string
        && get(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.ownerId == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if belongsToCurrentUsersClub(resource.data.clubId);
      allow create, update: if currentUserIsClubAdmin()
        && request.resource.data.clubId == currentUserClubId();
      allow delete: if currentUserIsClubAdmin()
        && resource.data.clubId == currentUserClubId();
    }

    match /announcements/{announcementId} {
      allow read: if canReadAnnouncement(resource.data);
      allow create, update: if canCreateOrUpdateAnnouncement(request.resource.data);
      allow delete: if canCreateOrUpdateAnnouncement(resource.data);
    }

    match /scheduleEvents/{scheduleEventId} {
      allow read: if canReadClubWideOrOwnTeamData(resource.data);
      allow create, update: if (currentUserIsClubAdmin()
          && request.resource.data.clubId == currentUserClubId())
        || canCoachManageOwnTeamData(request.resource.data);
      allow delete: if (currentUserIsClubAdmin()
          && resource.data.clubId == currentUserClubId())
        || canCoachManageOwnTeamData(resource.data);
    }

    match /attendanceRecords/{attendanceRecordId} {
      allow read: if canReadAttendance(resource.data);
      allow create, update: if canCreateOrUpdateAttendance(request.resource.data);
      allow delete: if (currentUserIsClubAdmin()
          && resource.data.clubId == currentUserClubId())
        || canCoachManageOwnTeamData(resource.data);
    }

    // Written only by the scheduled cleanupOldAttendance Cloud Function via
    // the Admin SDK (which bypasses these rules) -- clients can read their
    // own yearly totals, or a clubAdmin can read anyone's in their club, but
    // no client write path exists.
    match /attendanceSummaries/{userId} {
      allow read: if isSelf(userId)
        || (currentUserIsClubAdmin() && resource.data.clubId == currentUserClubId());
      allow write: if false;
    }

    // Bounce/complaint/suppression state mirrored from Resend's webhook
    // (resendWebhook function) and read back by requestEmailVerificationCode
    // before sending, both via the Admin SDK. No client needs this and it's
    // keyed by email rather than uid, so there's no self-access case either.
    match /emailDeliveryStatus/{email} {
      allow read, write: if false;
    }

    // Written only by the platform-admin Cloud Functions (getPlatformOverview
    // is read-only, setClubStatus writes here) via the Admin SDK, which
    // bypasses these rules entirely. No client, not even a clubAdmin, has
    // any business reading another club's admin action history.
    match /adminAuditLog/{logId} {
      allow read, write: if false;
    }

    // Single-use, platform-admin-generated club-signup promo codes.
    // Validity checking and redemption both happen only inside
    // startClubSignup's Firestore transaction (Admin SDK) -- a client that
    // could read a code's status could brute-force-guess unredeemed ones,
    // and a client that could write one could redeem it for free without
    // ever actually creating/paying for the club it's tied to.
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // A draft club captured while its first checkout is in flight; the real
    // clubs/{id} doc is only ever created afterward, by startClubSignup or
    // the Stripe webhook, via the Admin SDK. The client only ever polls its
    // own signup doc for resultClubId after returning from checkout -- it
    // must never write here, or it could fake resultClubId and walk into a
    // club it never paid for.
    match /pendingClubSignups/{signupId} {
      allow read: if verifiedEmail() && resource.data.createdByUid == request.auth.uid;
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if canReadPayment(resource.data);

      // A client (even a clubAdmin) can only ever create a manual,
      // freshly-unpaid record -- "online"-method payments are only ever
      // created by the monthly dues generator or the checkout function,
      // both via the Admin SDK, which bypasses these rules entirely.
      allow create: if currentUserIsClubAdmin()
        && request.resource.data.clubId == currentUserClubId()
        && request.resource.data.status == 'unpaid'
        && request.resource.data.amountCents is number
        && request.resource.data.amountCents > 0
        && (!('paymentMethod' in request.resource.data) || request.resource.data.paymentMethod == 'manual');

      // Once a payment is "online"-method, its status can only change via
      // the payment gateway's webhook (Admin SDK) -- a clubAdmin can still
      // edit everything else about it (e.g. re-send/void), just not fake a
      // paid status by hand once real money is supposed to be involved.
      allow update: if currentUserIsClubAdmin()
        && resource.data.clubId == currentUserClubId()
        && request.resource.data.clubId == resource.data.clubId
        && (
          !('paymentMethod' in resource.data)
          || resource.data.paymentMethod != 'online'
          || request.resource.data.status == resource.data.status
        );

      allow delete: if currentUserIsClubAdmin()
        && resource.data.clubId == currentUserClubId();
    }

    match /joinRequests/{joinRequestId} {
      allow create: if verifiedEmail()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.clubId is string
        && (request.resource.data.requestedRole == 'coach' || request.resource.data.requestedRole == 'parent' || request.resource.data.requestedRole == 'athlete')
        && request.resource.data.status == 'pending';

      allow read: if isSelf(resource.data.userId)
        || (currentUserIsClubAdmin() && resource.data.clubId == currentUserClubId());

      allow update: if currentUserIsClubAdmin()
        && resource.data.clubId == currentUserClubId()
        && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.userId == resource.data.userId;

      allow delete: if false;
    }

    match /chatGroups/{chatGroupId} {
      // Split into separate allow-read statements (instead of one canReadChatGroupData(resource.data)
      // OR'd boolean) because Firestore's list-query rule validator can't statically prove a compound
      // expression that mixes a get()-dependent branch (admin/team) with a plain resource.data array
      // membership check (visibleUserIds) -- it denies the whole `list` request outright even when every
      // returned document would individually satisfy the rule. Each statement below is validated
      // independently, and Firestore ORs the results, which list queries can prove document-by-document.
      allow read: if currentUserIsClubAdmin() && belongsToCurrentUsersClub(resource.data.clubId);
      allow read: if isCurrentUsersTeamData(resource.data) && belongsToCurrentUsersClub(resource.data.clubId);
      allow read: if belongsToCurrentUsersClub(resource.data.clubId)
        && ('visibleUserIds' in resource.data) && request.auth.uid in resource.data.visibleUserIds;
      allow create, update: if canCreateOrUpdateChatGroupData(request.resource.data);
      allow delete: if (currentUserIsClubAdmin()
          && resource.data.clubId == currentUserClubId())
        || canCoachManageOwnTeamData(resource.data);
    }

    match /chatMessages/{chatMessageId} {
      // Split for the same reason as chatGroups above -- a list query can't
      // be validated when a get()-dependent branch (admin) is OR'd together
      // with a plain resource.data array-membership check in one expression.
      allow read: if currentUserIsClubAdmin() && belongsToCurrentUsersClub(resource.data.clubId);
      allow read: if belongsToCurrentUsersClub(resource.data.clubId) && resource.data.senderUserId == request.auth.uid;
      allow read: if belongsToCurrentUsersClub(resource.data.clubId)
        && ('directUserIds' in resource.data) && request.auth.uid in resource.data.directUserIds;
      allow read: if belongsToCurrentUsersClub(resource.data.clubId)
        && ('visibleUserIds' in resource.data) && request.auth.uid in resource.data.visibleUserIds;
      allow create: if canCreateChatMessage(request.resource.data);
      allow update, delete: if false;
    }

    match /replays/{replayId} {
      // Split for the same reason as chatGroups above.
      allow read: if currentUserIsClubAdmin() && belongsToCurrentUsersClub(resource.data.clubId);
      allow read: if isCurrentUsersTeamData(resource.data) && belongsToCurrentUsersClub(resource.data.clubId);
      allow read: if belongsToCurrentUsersClub(resource.data.clubId) && resource.data.createdByUserId == request.auth.uid;
      allow read: if belongsToCurrentUsersClub(resource.data.clubId)
        && ('visibleUserIds' in resource.data) && request.auth.uid in resource.data.visibleUserIds;
      allow create, update: if canCreateOrUpdateReplay(request.resource.data);
      allow delete: if (currentUserIsClubAdmin()
          && resource.data.clubId == currentUserClubId())
        || canCoachManageOwnTeamData(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
