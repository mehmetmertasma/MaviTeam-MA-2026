# Copy this file and rename it to .env in this functions/ directory.
# Do not commit your real .env file. Loaded automatically by Firebase
# Functions v2 at deploy time -- no `firebase functions:secrets:set`
# needed, this isn't a secret (a Sentry DSN is a write-only ingestion
# endpoint, safe to be non-secret, same reasoning as the client's
# EXPO_PUBLIC_SENTRY_DSN).

# Optional -- crash/error monitoring. Leave blank to run without it.
SENTRY_DSN=
