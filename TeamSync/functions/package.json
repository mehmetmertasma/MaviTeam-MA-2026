{
  "name": "maviteam-functions",
  "description": "Cloud Functions for MaviTeam",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "lint": "echo \"No functions lint configured yet\"",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:cleanup": "npm exec --yes --package firebase-tools -- firebase emulators:exec --only firestore --project cleanup-test \"node test-cleanup.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  }
}
